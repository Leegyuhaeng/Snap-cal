# ─────────────────────────────────────────────
# 이 파일은 Git 에 올라간다. (실제 값이 아닌 '양식'이다)
#
# 새로 프로젝트를 받은 사람은:
#   1. cp .env.example .env
#   2. 아래 값들을 자기 환경에 맞게 채움
#   3. docker compose up -d
# ─────────────────────────────────────────────

PORT=4000
NODE_ENV=development

# Vue 개발 서버 주소 (Vite 기본 포트)
CORS_ORIGIN=http://localhost:5173

# ── Docker MySQL 컨테이너 설정 ──
# 로컬 개발 전용이므로 아무 값이나 정해도 된다.
# 단, 개인적으로 쓰는 비밀번호를 재사용하지 말 것.
MYSQL_ROOT_PASSWORD=여기에_원하는_비밀번호
MYSQL_DATABASE=snapcal_db

# ── Prisma 접속 주소 ──
# 위의 두 값과 일치시켜야 한다.
DATABASE_URL="mysql://root:여기에_원하는_비밀번호@localhost:3306/snapcal_db"
# 배포 시에는 Railway 가 발급한 주소로 교체한다 (애플리케이션 코드는 그대로)

# ── Step 4 에서 채울 것 ──
# JWT_SECRET=

# ── Step 7 에서 채울 것 ──
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ── Step 8 에서 채울 것 ──
# ANTHROPIC_API_KEY=
