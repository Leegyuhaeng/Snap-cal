// ─────────────────────────────────────────────────────────────
// AI 음식 사진 칼로리 분석 앱 — 데이터베이스 설계도
//
// 이 파일이 곧 ERD 그림이다. (eXERD 의 .exerd 파일에 해당)
// 이 파일을 고치고 `npx prisma migrate dev` 를 실행하면
//   ① 변경분만큼의 SQL 이 migrations/ 에 파일로 생성되고
//   ② 그 SQL 이 MySQL 에 실행되고
//   ③ TypeScript 타입이 자동으로 다시 만들어진다.
// ─────────────────────────────────────────────────────────────

generator client {
  // Prisma 7 의 새 생성기. 클라이언트를 node_modules 가 아니라
  // 우리 소스 트리 안에 만든다. (타입 추적이 쉬워지고 번들링에 유리)
  provider = "prisma-client"
  output   = "../src/generated/prisma"

  // 우리 tsconfig 가 CommonJS 이므로 맞춰 준다.
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
  // Prisma 7 부터 접속 주소(url)는 이 파일에 쓰지 않는다.
  // 마이그레이션용 주소는 프로젝트 루트의 prisma.config.ts 에 있다.
}

// ═══════════════════════════════════════════════════════════════
// 유저
// ═══════════════════════════════════════════════════════════════
model User {
  id           String @id @default(uuid())
  email        String @unique
  // ⚠️ 평문 비밀번호는 절대 저장하지 않는다. bcrypt 해시만 들어간다.
  passwordHash String
  nickname     String @db.VarChar(30)

  // 프로필 정보 (BMR 계산에 필요). 가입 직후에는 비어 있을 수 있어 nullable.
  gender        Gender?
  birthDate     DateTime?     @db.Date
  activityLevel ActivityLevel @default(SEDENTARY)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bodyRecords BodyRecord[]
  meals       Meal[]

  @@map("users")
}

// ═══════════════════════════════════════════════════════════════
// 신체 기록 — 덮어쓰지 않고 "쌓는다"
//
// User 에 weight 컬럼을 두고 UPDATE 하면 체중 변화 이력이 사라진다.
// 다이어트 앱에서 체중 그래프는 핵심 기능이 되므로 별도 테이블로 분리했다.
// ═══════════════════════════════════════════════════════════════
model BodyRecord {
  id     String @id @default(uuid())
  userId String

  heightCm Decimal @db.Decimal(5, 2) // 175.50
  weightKg Decimal @db.Decimal(5, 2) // 68.30

  // 계산 결과를 그 시점의 "스냅샷"으로 저장한다.
  // 나중에 계산 공식을 바꿔도 과거 기록이 왜곡되지 않는다.
  bmr  Int // 기초대사량
  tdee Int // 활동대사량 = bmr × 활동계수

  recordedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // "내 최신 기록 1건" 조회를 빠르게 하기 위한 복합 인덱스
  @@index([userId, recordedAt])
  @@map("body_records")
}

// ═══════════════════════════════════════════════════════════════
// 식사 1건 = 사진 1장
// ═══════════════════════════════════════════════════════════════
model Meal {
  id     String @id @default(uuid())
  userId String

  mealType MealType
  // 실제로 먹은 시각. createdAt(기록한 시각)과 다르다.
  // 어젯밤 야식을 오늘 아침에 기록할 수 있기 때문.
  // 캘린더는 항상 eatenAt 기준으로 그린다.
  eatenAt  DateTime

  // ⚠️ 이미지 바이너리는 DB 에 넣지 않는다.
  // 클라우드 스토리지에 올리고 주소만 저장한다.
  imageUrl String? @db.VarChar(500)
  imageKey String? @db.VarChar(255) // 스토리지에서 삭제할 때 필요한 식별자

  memo String? @db.Text

  // 비정규화 캐시. items 를 SUM 하면 구할 수 있지만,
  // 캘린더가 월 90건의 합계를 매번 계산하는 비용을 피하기 위해 미리 담아둔다.
  // ⚠️ MealItem 이 바뀌면 이 값도 트랜잭션으로 함께 갱신해야 한다.
  totalCalories Int @default(0)

  // 지금은 동기 처리라 항상 COMPLETED 로 끝나지만,
  // 나중에 큐 기반 비동기로 바꿀 때 스키마 변경 없이 대응하기 위해 미리 둔다.
  status AnalysisStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        MealItem[]
  analysisLogs AiAnalysisLog[]

  // ⭐ 캘린더 조회(WHERE userId = ? AND eatenAt BETWEEN ? AND ?)의 핵심 인덱스
  @@index([userId, eatenAt])
  @@map("meals")
}

// ═══════════════════════════════════════════════════════════════
// 음식 항목 — 사진 1장에 음식이 여러 개일 수 있다
//
// AI 응답을 JSON 문자열로 통째로 저장하면 당장은 편하지만
// "이번 달 많이 먹은 음식 TOP 5" 같은 집계가 불가능해진다.
// ═══════════════════════════════════════════════════════════════
model MealItem {
  id     String @id @default(uuid())
  mealId String

  name     String  @db.VarChar(100) // "김치찌개"
  quantity String? @db.VarChar(50) // "1인분", "150g"

  calories Int
  // Float 을 쓰면 0.1 + 0.2 = 0.30000000000000004 문제가 생긴다.
  // 영양성분처럼 정확해야 하는 값은 Decimal 을 쓴다.
  carbsG   Decimal @db.Decimal(6, 2) // 탄수화물
  proteinG Decimal @db.Decimal(6, 2) // 단백질
  fatG     Decimal @db.Decimal(6, 2) // 지방

  confidence Decimal? @db.Decimal(4, 3) // AI 확신도 0.000 ~ 1.000
  isEdited   Boolean  @default(false) // 유저가 값을 수정했는지

  meal Meal @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@index([mealId])
  @@map("meal_items")
}

// ═══════════════════════════════════════════════════════════════
// AI 원본 응답 로그
//
// AI 가 이상한 답을 줬을 때 원본을 볼 수 없으면 디버깅이 불가능하다.
// 프롬프트 개선, 모델 비교에도 필요한 데이터.
// ═══════════════════════════════════════════════════════════════
model AiAnalysisLog {
  id     String @id @default(uuid())
  mealId String

  provider    String @db.VarChar(50) // "anthropic"
  model       String @db.VarChar(100)
  rawResponse Json // AI 가 뱉은 응답 그대로
  latencyMs   Int // 응답에 걸린 시간 (성능 추적용)

  createdAt DateTime @default(now())

  meal Meal @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@index([mealId])
  @@map("ai_analysis_logs")
}

// ═══════════════════════════════════════════════════════════════
// Enum — MySQL 의 ENUM 타입으로 생성되고, TypeScript 타입으로도 나온다
// ═══════════════════════════════════════════════════════════════

enum Gender {
  MALE
  FEMALE
}

enum ActivityLevel {
  SEDENTARY // 거의 안 움직임    × 1.2
  LIGHT // 주 1~3회 운동     × 1.375
  MODERATE // 주 3~5회 운동     × 1.55
  ACTIVE // 주 6~7회 운동     × 1.725
  VERY_ACTIVE // 육체노동/운동선수  × 1.9
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum AnalysisStatus {
  PENDING // 분석 대기 / 진행 중
  COMPLETED // 분석 완료
  FAILED // 분석 실패
}
