{
  "compilerOptions": {
    /* 어떤 JS 문법까지 쓸 수 있는지. Node 20+ 이면 ES2022 안전 */
    "target": "ES2022",
    "lib": ["ES2022"],

    /* 서버는 CommonJS(require)가 아직 가장 속 편하다. 아래 설명 참고 */
    "module": "commonjs",
    "moduleResolution": "node",

    /* 빌드 결과물 위치 */
    "rootDir": "./src",
    "outDir": "./dist",

    /* ⭐ 타입 안전장치 (이거 끄면 TS 쓰는 의미가 없다) */
    "strict": true,
    "noUncheckedIndexedAccess": true,

    /* import express from 'express' 문법을 쓰게 해줌 */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    /* node_modules 타입 검사 생략 → 빌드 속도 대폭 향상 */
    "skipLibCheck": true,

    "resolveJsonModule": true,
    "sourceMap": true,
    "declaration": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
